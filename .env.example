# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Database
DATABASE_URL=postgresql+asyncpg://genquantaa:genquantaa@localhost:5432/genquantaa

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Authentication - set a long random value in every deployed environment
AUTH_SECRET=change-this-to-a-long-random-secret

# RBAC bootstrap - comma-separated emails that receive privileged roles
BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_CTO_EMAILS=
